---
import SectionHeading from '../components/ui/SectionHeading.astro'
import PlaceholderImage from '../components/ui/PlaceholderImage.astro'
import { contact } from '../lib/contact.js'

const { proyectos } = Astro.props
---

<section id="proyectos" class="bg-surface-warm py-26">
  <div class="container-page">
    <SectionHeading>Proyectos</SectionHeading>

    <div class="mt-10 space-y-20">
      {proyectos.map((proyecto) => (
        <div
          class:list={[
            'grid items-center gap-9 lg:gap-[35px]',
            proyecto.imagenPrimero ? 'lg:grid-cols-[820fr_266fr]' : 'lg:grid-cols-[266fr_820fr]',
          ]}
        >
          <PlaceholderImage
            label={proyecto.titulo}
            class={`aspect-[820/461] w-full rounded-2xl ${proyecto.imagenPrimero ? '' : 'lg:order-2'}`}
          />
          <p
            class:list={[
              'text-2xl leading-normal text-black sm:text-[32px]',
              !proyecto.imagenPrimero && 'lg:order-1',
            ]}
          >
            {proyecto.titulo}
          </p>
        </div>
      ))}
    </div>

    <p class="mt-20 text-center text-base text-stone">
      Para ver más proyectos <a
        href={contact.whatsappLink}
        class="font-semibold text-clay underline"
        target="_blank"
        rel="noopener noreferrer"
      >contáctame</a>
    </p>
  </div>
</section>
