---
import { Image } from 'astro:assets'
import SectionHeading from '../components/ui/SectionHeading.astro'
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro'
import { servicios } from '../data/servicios.js'
---

<section
  id="servicios"
  class="bg-surface py-26 lg:py-24"
>
  <div class="container-page">
    <SectionHeading data-aparecer>Servicios</SectionHeading>

    <div data-aparecer class="mt-8 flex max-w-3xl flex-col gap-5 text-lg leading-lectura text-stone sm:text-xl">
      <p>
        Realizo todo tipo de reformas y trabajos en viviendas y locales comerciales, instalaciones, distribución, suelos,
        paredes, techos, baño y cocina.
      </p>
      <p>
        Trabajo en pisos del casco urbano, casas de campo, chalets de urbanizaciones como Condado de Alhama y locales
        comerciales.
      </p>
    </div>

    {/* Carrusel con scroll-snap nativo: se desliza con el dedo, el trackpad o el
        teclado sin JavaScript. Los botones son una mejora que se activa encima. */}
    <div
      class="relative mt-12"
      data-aparecer
      data-carrusel
      role="region"
      aria-roledescription="carrusel"
      aria-label="Servicios"
    >
      <ul
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto select-none scrollbar-none [&::-webkit-scrollbar]:hidden [@media(hover:hover)]:cursor-grab [@media(hover:hover)]:snap-none"
        style="--fi: 0px; --fd: 0px; -webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0) calc(var(--fi) * 0.5), rgb(0 0 0 / 0.6) calc(var(--fi) * 0.75), #000 var(--fi), #000 calc(100% - var(--fd)), rgb(0 0 0 / 0.6) calc(100% - var(--fd) * 0.75), rgb(0 0 0 / 0) calc(100% - var(--fd) * 0.5), rgb(0 0 0 / 0) 100%); mask-image: linear-gradient(to right, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0) calc(var(--fi) * 0.5), rgb(0 0 0 / 0.6) calc(var(--fi) * 0.75), #000 var(--fi), #000 calc(100% - var(--fd)), rgb(0 0 0 / 0.6) calc(100% - var(--fd) * 0.75), rgb(0 0 0 / 0) calc(100% - var(--fd) * 0.5), rgb(0 0 0 / 0) 100%)"
        data-pista
      >
        {servicios.map((servicio) => (
          <li class="w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[22%]">
            <a
              href={servicio.enlace}
              target="_blank"
              rel="noreferrer"
              class="group relative flex aspect-4/5 flex-col justify-between overflow-hidden rounded-2xl bg-linear-to-br from-ink to-stone p-5 text-white focus-visible:ring-3 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              {servicio.foto && (
                <Image
                  src={servicio.foto}
                  alt=""
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1024px) 260px, (min-width: 640px) 46vw, 78vw"
                  class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                />
              )}
              {/* Oscurece arriba y abajo, donde va el texto, y deja ver la foto en medio. */}
              <div aria-hidden="true" class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/15 to-ink/15"></div>

              <h3 class="relative text-lg leading-snug font-bold">{servicio.nombre}</h3>
            </a>
          </li>
        ))}
      </ul>

      {/* Ocultos hasta que el script confirma que pueden funcionar. Son dos flechas altas y
          finas del color del texto, colocadas fuera de la pista, a los lados. */}
      <button
        type="button"
        data-anterior
        hidden
        aria-label="Servicio anterior"
        class="absolute top-1/2 -left-8 z-10 hidden h-72 w-20 -translate-y-1/2 items-center justify-start text-stone lg:-left-10 transition hover:scale-y-105 hover:text-ink focus-visible:ring-3 focus-visible:ring-clay/50 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-0 md:flex"
      >
        <svg width="28" height="140" viewBox="0 0 28 140" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M24 4L4 70l20 66" />
        </svg>
      </button>
      <button
        type="button"
        data-siguiente
        hidden
        aria-label="Servicio siguiente"
        class="absolute top-1/2 -right-8 z-10 hidden h-72 w-20 -translate-y-1/2 items-center justify-end text-stone lg:-right-10 transition hover:scale-y-105 hover:text-ink focus-visible:ring-3 focus-visible:ring-clay/50 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-0 md:flex"
      >
        <svg width="28" height="140" viewBox="0 0 28 140" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M4 4l20 66L4 136" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-carrusel]').forEach((carrusel) => {
    const pista = carrusel.querySelector('[data-pista]')
    const anterior = carrusel.querySelector('[data-anterior]')
    const siguiente = carrusel.querySelector('[data-siguiente]')

    anterior.hidden = false
    siguiente.hidden = false

    // Avanza exactamente una tarjeta más el hueco, para caer siempre en un punto de snap.
    const paso = () =>
      pista.firstElementChild.getBoundingClientRect().width +
      parseFloat(getComputedStyle(pista).columnGap)
    const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches
    const mover = (sentido) => pista.scrollBy({ left: sentido * paso(), behavior: suave ? 'smooth' : 'auto' })

    anterior.addEventListener('click', () => mover(-1))
    siguiente.addEventListener('click', () => mover(1))

    // Los bordes de la pista se desvanecen solo si hay más tarjetas al otro lado, y tanto
    // como lo que queda por recorrer (hasta 40 px): así lo que sale parece ir saliendo.
    const desvanecer = () => {
      const resto = pista.scrollWidth - pista.clientWidth - pista.scrollLeft
      pista.style.setProperty('--fi', `${Math.max(0, Math.min(pista.scrollLeft, 40))}px`)
      pista.style.setProperty('--fd', `${Math.max(0, Math.min(resto, 40))}px`)
    }

    const actualizar = () => {
      const enfocado = document.activeElement
      anterior.disabled = pista.scrollLeft <= 1
      siguiente.disabled = pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - 1
      // Un botón desactivado pierde el foco: se pasa al otro para no dejarlo en el aire.
      if (enfocado?.disabled) (enfocado === anterior ? siguiente : anterior).focus()
      desvanecer()
    }
    pista.addEventListener('scroll', actualizar, { passive: true })
    window.addEventListener('resize', actualizar)
    actualizar()

    // Con ratón se arrastra como con el dedo: la pista sigue al puntero y se queda donde se
    // suelta, sin encajar en ninguna tarjeta (con ratón no hay snap), y al soltar conserva
    // un poco de inercia.
    let inicioX = 0
    let inicioScroll = 0
    let pulsado = false
    let arrastrando = false
    let muestras = []
    let inercia = 0

    const parar = () => cancelAnimationFrame(inercia)

    pista.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return
      parar()
      pulsado = true
      arrastrando = false
      inicioX = e.clientX
      inicioScroll = pista.scrollLeft
      muestras = []
    })
    pista.addEventListener('pointermove', (e) => {
      if (!pulsado) return
      const dx = e.clientX - inicioX
      if (!arrastrando && Math.abs(dx) > 5) {
        arrastrando = true
        pista.setPointerCapture(e.pointerId)
        pista.style.cursor = 'grabbing'
      }
      if (!arrastrando) return
      pista.scrollLeft = inicioScroll - dx
      muestras.push({ t: e.timeStamp, x: pista.scrollLeft })
      muestras = muestras.filter((m) => e.timeStamp - m.t < 100)
    })
    const soltar = (e) => {
      if (!pulsado) return
      pulsado = false
      if (!arrastrando) return
      pista.style.cursor = ''
      // El clic que sigue a un arrastre no debe abrir el enlace de la tarjeta.
      setTimeout(() => (arrastrando = false), 0)

      const primera = muestras[0]
      if (!suave || !primera || e.timeStamp - primera.t === 0) return
      let velocidad = (pista.scrollLeft - primera.x) / (e.timeStamp - primera.t) // px/ms
      let anterior = performance.now()
      const frenar = (ahora) => {
        const dt = ahora - anterior
        anterior = ahora
        pista.scrollLeft += velocidad * dt
        velocidad *= Math.pow(0.995, dt)
        if (Math.abs(velocidad) > 0.02) inercia = requestAnimationFrame(frenar)
      }
      inercia = requestAnimationFrame(frenar)
    }
    pista.addEventListener('pointerup', soltar)
    pista.addEventListener('pointercancel', soltar)
    pista.addEventListener('wheel', parar, { passive: true })
    pista.addEventListener('click', (e) => arrastrando && e.preventDefault(), true)
    pista.addEventListener('dragstart', (e) => e.preventDefault())
  })
</script>
