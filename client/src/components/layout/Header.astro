---
import WhatsAppIcon from '../icons/WhatsAppIcon.astro'
import PhoneIcon from '../icons/PhoneIcon.astro'
import { contact } from '../../lib/contact.js'

const NAV_LINKS = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#zona', label: 'Zona' },
  { href: '#contacto', label: 'Contacto' },
]

const {
  homeHref = '/',
  navLinks = NAV_LINKS,
  background = 'bg-surface-warm',
} = Astro.props
---

<header class:list={['fixed inset-x-0 top-0 z-50 border-b border-ink/10', background]}>
  <div class="container-page flex min-h-18 items-center justify-between gap-5">
    <a
      href={homeHref}
      class="text-sm font-black tracking-[-0.04em] focus-visible:ring-3 focus-visible:ring-clay/35 focus-visible:outline-none"
    >
      REFORMAS <span class="text-clay">GRUBEK</span>
    </a>

    <nav
      aria-label="Navegación principal"
      class="hidden items-center gap-7 text-sm font-semibold text-stone lg:flex"
    >
      {navLinks.map((link) => (
        <a class="hover:text-ink focus-visible:text-ink focus-visible:outline-none" href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {/* El número solo cabe a partir de sm; por debajo ya está el botón de llamar
          de la barra inferior fija, así que aquí se oculta. */}
      <a
        class="button-secondary hidden min-h-10 px-4 text-xs sm:inline-flex"
        href={contact.phoneLink}
      >
        <PhoneIcon /> {contact.phoneDisplay}
      </a>

      <a
        class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-clay text-lg text-white transition hover:bg-clay-dark focus-visible:ring-3 focus-visible:ring-clay/35 focus-visible:ring-offset-2 focus-visible:outline-none"
        href={contact.whatsappLink}
        target="_blank"
        rel="noreferrer"
        aria-label="Hablar por WhatsApp"
      >
        <WhatsAppIcon />
      </a>
    </div>
  </div>
</header>
