---
// Titular de sección del diseño: Noto Serif, 32px en móvil y 48px a partir de sm.
const { inverted = false, class: className = '' } = Astro.props
---

<h2
  class:list={[
    'font-serif text-[32px] leading-normal font-bold tracking-[-0.03em] sm:text-[48px]',
    inverted ? 'text-white' : 'text-black',
    className,
  ]}
>
  <slot />
</h2>
